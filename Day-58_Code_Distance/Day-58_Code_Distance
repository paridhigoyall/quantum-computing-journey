# ------------------------------------------------------------
# Check whether an operator preserves the code space
#
# We check whether E|0_L> and E|1_L> remain inside the
# logical code space.
# ------------------------------------------------------------

def preserves_code_space(operator):
    result_zero = operator @ logical_zero
    result_one = operator @ logical_one

    # Project onto the code space
    P0 = np.vdot(logical_zero, result_zero)
    P1 = np.vdot(logical_one, result_one)

    reconstructed_zero = P0 * logical_zero
    reconstructed_one = P1 * logical_one

    zero_preserved = np.allclose(
        result_zero,
        reconstructed_zero
    )

    one_preserved = np.allclose(
        result_one,
        reconstructed_one
    )

    return zero_preserved and one_preserved


# ------------------------------------------------------------
# Check whether an operator is a stabilizer
#
# Stabilizer group for this code:
#
# III
# ZZI
# IZZ
# ZIZ
# ------------------------------------------------------------

stabilizers = {
    "III",
    "ZZI",
    "IZZ",
    "ZIZ"
}


# ------------------------------------------------------------
# Find minimum-weight logical operators
# ------------------------------------------------------------

logical_operators = []

for label in pauli_strings:

    if label in stabilizers:
        continue

    operator = pauli_operator(label)

    if preserves_code_space(operator):

        weight = operator_weight(label)

        logical_operators.append(
            (weight, label)
        )


logical_operators.sort()


print("\nNon-stabilizer Pauli operators preserving code space:")

for weight, label in logical_operators:
    print(f"{label}  -> weight {weight}")


