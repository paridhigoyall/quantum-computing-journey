# ------------------------------------------------------------
# Basic Pauli matrices
# ------------------------------------------------------------

I = np.eye(2, dtype=complex)

X = np.array([
    [0, 1],
    [1, 0]
], dtype=complex)

Y = np.array([
    [0, -1j],
    [1j, 0]
], dtype=complex)

Z = np.array([
    [1, 0],
    [0, -1]
], dtype=complex)


# ------------------------------------------------------------
# Tensor product helper
# ------------------------------------------------------------

def kron_all(operators):
    result = operators[0]

    for op in operators[1:]:
        result = np.kron(result, op)

    return result


# ------------------------------------------------------------
# 3-qubit Pauli operator
#
# Example:
# "XII" = X on qubit 0
# "IXI" = X on qubit 1
# "IIX" = X on qubit 2
# ------------------------------------------------------------

PAULIS = {
    "I": I,
    "X": X,
    "Y": Y,
    "Z": Z
}


def pauli_operator(label):
    return kron_all([PAULIS[p] for p in label])


# ------------------------------------------------------------
# Operator weight
#
# Weight = number of non-identity operations
# ------------------------------------------------------------

def operator_weight(label):
    return sum(1 for p in label if p != "I")


# ------------------------------------------------------------
# Logical code states
#
# |0_L> = |000>
# |1_L> = |111>
#
# Arbitrary logical state:
#
# |psi_L> = alpha|000> + beta|111>
# ------------------------------------------------------------

logical_zero = np.zeros(8, dtype=complex)
logical_zero[0] = 1.0

logical_one = np.zeros(8, dtype=complex)
logical_one[7] = 1.0


# Example logical state

alpha = 1 / np.sqrt(3)
beta = np.sqrt(2 / 3)

logical_state = alpha * logical_zero + beta * logical_one


# ------------------------------------------------------------
# Stabilizers
#
# S1 = Z0 Z1
# S2 = Z1 Z2
#
# In label notation:
#
# ZZI = Z on q0 and q1
# IZZ = Z on q1 and q2
# ------------------------------------------------------------

S1 = pauli_operator("ZZI")
S2 = pauli_operator("IZZ")


# ------------------------------------------------------------
# Logical operators
#
# Logical X:
#
# X_L = X0 X1 X2
#
# This maps:
#
# |000> -> |111>
# |111> -> |000>
#
# Therefore:
#
# weight(X_L) = 3
# ------------------------------------------------------------

logical_X = pauli_operator("XXX")


# Logical Z can be represented by Z on any one
# physical qubit inside the code space.
#
# Z0 is:
#
# ZII
#
# It gives:
#
# Z|0_L> = |0_L>
# Z|1_L> = -|1_L>
#
# Therefore it acts as logical Z.
#
# weight(Z_L) = 1

logical_Z = pauli_operator("ZII")


# ------------------------------------------------------------
# Utility functions
# ------------------------------------------------------------

def expectation(state, operator):
    return np.vdot(state, operator @ state)


def normalize(state):
    norm = np.linalg.norm(state)

    if norm == 0:
        return state

    return state / norm


def fidelity(state_a, state_b):
    overlap = np.vdot(state_a, state_b)

    return abs(overlap) ** 2


