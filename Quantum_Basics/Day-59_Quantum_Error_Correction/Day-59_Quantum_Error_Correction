import numpy as np


# ============================================================
# DAY 59
# SYNDROME-BASED QUANTUM ERROR CORRECTION
#
# 3-QUBIT BIT-FLIP REPETITION CODE
# ============================================================


# ------------------------------------------------------------
# 1. BASIC PAULI MATRICES
# ------------------------------------------------------------

I = np.eye(2, dtype=complex)

X = np.array([
    [0, 1],
    [1, 0]
], dtype=complex)

Y = np.array([
    [0, -1j],
    [1j, 0]
], dtype=complex)

Z = np.array([
    [1, 0],
    [0, -1]
], dtype=complex)


# ------------------------------------------------------------
# 2. TENSOR PRODUCT
# ------------------------------------------------------------

def kron_all(operators):
    result = operators[0]

    for operator in operators[1:]:
        result = np.kron(result, operator)

    return result


# ------------------------------------------------------------
# 3. CREATE 3-QUBIT OPERATORS
#
# "XII" -> X on qubit 0
# "IXI" -> X on qubit 1
# "IIX" -> X on qubit 2
# ------------------------------------------------------------

PAULIS = {
    "I": I,
    "X": X,
    "Y": Y,
    "Z": Z
}


def pauli_operator(label):
    return kron_all([PAULIS[p] for p in label])


# ------------------------------------------------------------
# 4. BASIS STATES
# ------------------------------------------------------------

zero = np.array([1, 0], dtype=complex)
one = np.array([0, 1], dtype=complex)


# ------------------------------------------------------------
# 5. LOGICAL STATES
#
# |0_L> = |000>
# |1_L> = |111>
# ------------------------------------------------------------

logical_zero = np.zeros(8, dtype=complex)
logical_zero[0] = 1.0

logical_one = np.zeros(8, dtype=complex)
logical_one[7] = 1.0


# ------------------------------------------------------------
# 6. CREATE AN ARBITRARY LOGICAL QUBIT
#
# |psi_L> = alpha|000> + beta|111>
# ------------------------------------------------------------

alpha = 1 / np.sqrt(3)

beta = np.sqrt(2 / 3)

logical_state = (
    alpha * logical_zero
    + beta * logical_one
)


# ------------------------------------------------------------
# 7. STABILIZERS
#
# S1 = Z0 Z1
# S2 = Z1 Z2
#
# These allow us to determine which qubit
# experienced a bit-flip.
# ------------------------------------------------------------

S1 = pauli_operator("ZZI")

S2 = pauli_operator("IZZ")


# ------------------------------------------------------------
# 8. ERROR OPERATORS
# ------------------------------------------------------------

X0 = pauli_operator("XII")
X1 = pauli_operator("IXI")
X2 = pauli_operator("IIX")

Y0 = pauli_operator("YII")
Z0 = pauli_operator("ZII")


# ------------------------------------------------------------
# 9. APPLY ERROR
# ------------------------------------------------------------

def apply_error(state, error_operator):

    return error_operator @ state


# ------------------------------------------------------------
# 10. MEASURE STABILIZER
#
# For an error state:
#
# +1 -> syndrome bit 0
# -1 -> syndrome bit 1
# ------------------------------------------------------------

def stabilizer_value(state, stabilizer):

    expectation = np.vdot(
        state,
        stabilizer @ state
    )

    # Numerical rounding
    expectation = np.real_if_close(expectation)

    if np.real(expectation) > 0:
        return +1

    return -1


# ------------------------------------------------------------
# 11. EXTRACT SYNDROME
# ------------------------------------------------------------

def get_syndrome(state):

    s1 = stabilizer_value(state, S1)

    s2 = stabilizer_value(state, S2)

    return s1, s2


# ------------------------------------------------------------
# 12. CONVERT SYNDROME TO BINARY
#
# +1 -> 0
# -1 -> 1
# ------------------------------------------------------------

def syndrome_bits(syndrome):

    s1, s2 = syndrome

    bit1 = 0 if s1 == +1 else 1
    bit2 = 0 if s2 == +1 else 1

    return f"{bit1}{bit2}"


# ------------------------------------------------------------
# 13. DECODER
#
# Syndrome table:
#
# 00 -> no error
# 10 -> X0
# 11 -> X1
# 01 -> X2
# ------------------------------------------------------------

def decode_syndrome(syndrome):

    bits = syndrome_bits(syndrome)

    if bits == "00":

        return "No error", I

    elif bits == "10":

        return "X0", X0

    elif bits == "11":

        return "X1", X1

    elif bits == "01":

        return "X2", X2

    else:

        return "Unknown", I


# ------------------------------------------------------------
# 14. CORRECT ERROR
# ------------------------------------------------------------

def correct_error(state):

    syndrome = get_syndrome(state)

    error_name, correction = decode_syndrome(syndrome)

    corrected_state = correction @ state

    return corrected_state, syndrome, error_name


# ------------------------------------------------------------
# 15. FIDELITY
# ------------------------------------------------------------

def fidelity(state1, state2):

    overlap = np.vdot(state1, state2)

    return abs(overlap) ** 2


