# ============================================================
# PART 3
# TEST SINGLE BIT-FLIP ERRORS
# ============================================================

print("\n" + "=" * 65)
print("SINGLE BIT-FLIP ERROR CORRECTION")
print("=" * 65)


single_bit_flip_errors = {
    "No error": I,
    "X0": X0,
    "X1": X1,
    "X2": X2
}


for error_name, error_operator in single_bit_flip_errors.items():

    # ----------------------------------------
    # Apply error
    # ----------------------------------------

    corrupted_state = apply_error(
        logical_state,
        error_operator
    )

    # ----------------------------------------
    # Fidelity BEFORE correction
    # ----------------------------------------

    before = fidelity(
        logical_state,
        corrupted_state
    )

    # ----------------------------------------
    # Extract syndrome
    # ----------------------------------------

    syndrome = get_syndrome(
        corrupted_state
    )

    bits = syndrome_bits(
        syndrome
    )

    # ----------------------------------------
    # Decode and correct
    # ----------------------------------------

    corrected_state, _, correction = correct_error(
        corrupted_state
    )

    # ----------------------------------------
    # Fidelity AFTER correction
    # ----------------------------------------

    after = fidelity(
        logical_state,
        corrected_state
    )

    print("\n----------------------------------------")

    print("Actual error :", error_name)

    print(
        "Syndrome     :",
        bits
    )

    print(
        "Correction   :",
        correction
    )

    print(
        f"Fidelity before correction : {before:.6f}"
    )

    print(
        f"Fidelity after correction  : {after:.6f}"
    )


# ============================================================
# PART 4
# VERIFY AUTOMATIC DECODER
# ============================================================

print("\n" + "=" * 65)
print("AUTOMATIC DECODER TEST")
print("=" * 65)


all_correct = True


for error_name, error_operator in single_bit_flip_errors.items():

    corrupted = apply_error(
        logical_state,
        error_operator
    )

    corrected, syndrome, correction_name = correct_error(
        corrupted
    )

    final_fidelity = fidelity(
        logical_state,
        corrected
    )

    success = np.isclose(
        final_fidelity,
        1.0
    )

    if not success:
        all_correct = False

    print(
        f"{error_name:<10} "
        f"Syndrome={syndrome_bits(syndrome)} "
        f"Correction={correction_name:<15} "
        f"Fidelity={final_fidelity:.6f} "
        f"Success={success}"
    )


print("\nAll single bit-flip errors corrected:",
      all_correct)


